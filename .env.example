# Kopieren nach .env und ausfuellen. .env ist per .gitignore ausgeschlossen.

# --- RPC (empfohlen) --------------------------------------------------------
# Der oeffentliche Solana-RPC beantwortet getTokenLargestAccounts nicht.
# Ohne eigenen RPC kommen die Holder-Daten von RugCheck statt direkt von der
# Chain. Helius hat einen kostenlosen Tarif, der dafuer ausreicht.
# HELIUS_API_KEY=

# Alternativ ein beliebiger anderer RPC (hat Vorrang vor HELIUS_API_KEY):
# XENO_RPC_URL=

# --- Telegram (fuer den Watch-Modus) ----------------------------------------
# 1. In Telegram @BotFather anschreiben, /newbot senden, Token hier eintragen
# 2. Dem eigenen Bot eine beliebige Nachricht schicken
# 3. "python3 -m xeno telegram-setup" ausfuehren - das zeigt die Chat-ID
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Pfad der Zustandsdatei des Watchers (Standard: xeno-state.json)
# XENO_STATE_FILE=

# --- Suchprofil -------------------------------------------------------------
# early       frische Pools mit erster Beteiligung, 2min-6h  (Standard)
# balanced    bereits handelbare Token, 3min-3 Tage
# established grosse laufende Token, ab 1h
# XENO_PROFILE=early

# --- Vorfilter (Stage 1) ----------------------------------------------------
# Diese Werte uebersteuern einzeln das Profil. Leer lassen = Profil entscheidet.
# XENO_MIN_LIQUIDITY=5000
# XENO_MAX_LIQUIDITY=5000000
# XENO_MIN_VOLUME_H1=2000
# XENO_MIN_AGE_MINUTES=3
# XENO_MAX_AGE_HOURS=72
# XENO_MIN_BUYERS_H1=25
# XENO_MIN_BUY_SELL_RATIO=0.8
# XENO_MAX_VOL_LIQ=60

# --- Risikogrenzen (Stage 2) ------------------------------------------------
# XENO_MAX_TOP10_PCT=30
# XENO_MAX_SINGLE_HOLDER_PCT=10
# XENO_MAX_CREATOR_PCT=5
# XENO_MAX_BUNDLE_PCT=20
# XENO_MIN_LP_LOCKED_PCT=90
# XENO_MIN_HOLDER_COUNT=100
# XENO_HEALTHY_LIQUIDITY=10000

# --- Netzwerk ---------------------------------------------------------------
# XENO_RPC_RATE_LIMIT=2
# XENO_HTTP_RATE_LIMIT=4
# XENO_TIMEOUT=25
# XENO_MAX_RETRIES=4

# --- Dashboard --------------------------------------------------------------
# Eigenes Zugangswort fuer "xeno serve --lan" (mind. 6 Zeichen). Ohne Angabe
# wird bei Netzwerk-Freigabe ein zufaelliges erzeugt.
# XENO_WEB_TOKEN=
